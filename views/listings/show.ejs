<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3 justify-content-center">
  <div class="col-12 col-md-10 col-lg-8">
    <h3 class="mb-3 fw-bold"><%= listing.title %></h3>
  </div>

  <div class="card col-12 col-md-10 col-lg-8 show-card listing-card">
    <img
      src="<%= listing.image?.url || '/images/default.jpg' %>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body pt-3">
      <p class="card-text text-muted mb-2">
        Hosted by <strong><%= listing.owner ? listing.owner.username : 'Unknown' %></strong>
      </p>

      <p class="card-text fs-6 mb-3"><%= listing.description %></p>
      
      <p class="card-text fw-bold fs-5 text-dark mb-2">
        &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
        <span class="fw-normal fs-6 text-muted">/ night</span>
      </p>

      <p class="card-text text-secondary mb-2">
        <i class="fa-solid fa-location-dot text-danger me-2"></i><%= listing.location %>, <%= listing.country %>
      </p>
    </div>
  </div>

  <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
  <div class="col-12 col-md-10 col-lg-8 d-flex flex-wrap gap-2 gap-sm-3 my-3">
    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn btn-dark edit-btn px-4 py-2"
    >
      <i class="fa-solid fa-pen-to-square me-1"></i> Edit
    </a>

    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
      <button class="btn btn-outline-danger px-4 py-2">
        <i class="fa-solid fa-trash me-1"></i> Delete
      </button>
    </form>
  </div>
  <% } %>

  <div class="col-12 col-md-10 col-lg-8 mb-4">
    <% if(currUser) { %>
      <hr />
      <h4 class="mb-3 fw-semibold">Leave a Review</h4>
      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >
        <div class="mb-3">
          <label for="rating" class="form-label fw-semibold">Rating</label>
          <fieldset class="starability-slot">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
            />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />
            <label for="first-rate3" title="Average">3 stars</label>
            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label fw-semibold">Comments</label>
          <textarea
            name="review[comment]"
            id="comment"
            rows="4"
            class="form-control auth-input"
            placeholder="Share details of your experience..."
            required
          ></textarea>
          <div class="invalid-feedback">Please add some comments for your review.</div>
        </div>
        <button class="btn btn-dark px-4 py-2">Submit Review</button>
      </form>
    <% } %>

    <% if(listing.reviews && listing.reviews.length > 0) { %>
      <hr />
      <h5 class="mb-3 fw-bold">All Reviews (<%= listing.reviews.length %>)</h5>
      <div class="row g-3">
        <% for(review of listing.reviews) { %>
        <div class="col-12 col-md-6">
          <div class="card h-100 p-3 border shadow-sm rounded-3">
            <div class="card-body p-0">
              <div class="d-flex align-items-center gap-2 mb-2">
                <i class="fa-solid fa-circle-user fs-4 text-secondary"></i>
                <h6 class="card-title mb-0 fw-semibold">@<%= review.author ? review.author.username : 'Anonymous' %></h6>
              </div>
              <p
                class="starability-result card-text mb-2"
                data-rating="<%= review.rating %>"
              ></p>
              <p class="card-text text-secondary mb-2"><%= review.comment %></p>

              <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
              <form
                class="mt-2"
                method="POST"
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
              >
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
              <% } %>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="col-12 col-md-10 col-lg-8 mb-5">
    <h4 class="mb-3 fw-bold">Where you'll be</h4>
    <div id="map"></div>
  </div>
</div>

<script src="/js/map.js"></script>
