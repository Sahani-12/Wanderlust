<% layout("/layouts/boilerplate") %>

<div class="container d-flex justify-content-center align-items-center py-4">
  <div class="form-card p-4">
    <h4 class="text-center mb-1 fw-semibold">Edit Listing</h4>
    <p class="text-center text-muted mb-4 small">Update your CareConnect listing</p>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=PUT"
      class="needs-validation"
      novalidate
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label class="form-label fw-semibold">Title</label>
        <input
          type="text"
          name="listing[title]"
          value="<%= listing.title %>"
          class="form-control auth-input"
          required
        />
        <div class="invalid-feedback">Title is required.</div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Description</label>
        <textarea
          name="listing[description]"
          rows="3"
          class="form-control auth-input"
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback">Description is required.</div>
      </div>

      <% if (listing.image && listing.image.url) { %>
      <div class="mb-3">
        <label class="form-label fw-semibold">Current Image</label>
        <div>
          <img
            src="<%= originalImageUrl || listing.image.url %>"
            class="img-fluid rounded mb-2 border shadow-sm"
            style="max-height: 200px; width: 100%; object-fit: cover;"
            alt="Current Listing Image"
          />
        </div>
      </div>
      <% } %>

      <div class="mb-3">
        <label class="form-label fw-semibold">Replace Image (Optional, max 5MB)</label>
        <input
          type="file"
          name="listing[image]"
          accept="image/jpeg,image/png,image/jpg,image/webp"
          class="form-control auth-input"
        />
      </div>

      <div class="row g-3 mb-3">
        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Price (₹ / night)</label>
          <input
            type="number"
            name="listing[price]"
            value="<%= listing.price %>"
            class="form-control auth-input"
            min="0"
            required
          />
          <div class="invalid-feedback">Valid price is required.</div>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Country</label>
          <input
            type="text"
            name="listing[country]"
            value="<%= listing.country %>"
            class="form-control auth-input"
            required
          />
          <div class="invalid-feedback">Country is required.</div>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label fw-semibold">Location</label>
        <input
          type="text"
          name="listing[location]"
          value="<%= listing.location %>"
          class="form-control auth-input"
          required
        />
        <div class="invalid-feedback">Location is required.</div>
      </div>

      <button class="auth-btn w-100" type="submit">Update Listing</button>
    </form>
  </div>
</div>
