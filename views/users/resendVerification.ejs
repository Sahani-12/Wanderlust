<% layout("/layouts/boilerplate") %>

<div class="container d-flex justify-content-center align-items-center py-4 py-md-5">
  <div class="auth-card p-4">
    <div class="text-center mb-3">
      <i class="fa-solid fa-envelope-open-text text-danger" style="font-size: 2.75rem;"></i>
    </div>
    <h4 class="text-center mb-1 fw-semibold">Resend Verification</h4>
    <p class="text-center text-muted mb-4 small">
      Enter your email address and we will send you a fresh verification link.
    </p>

    <form action="/resend-verification" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label class="form-label fw-semibold">Email Address</label>
        <input
          type="email"
          name="email"
          value="<%= currUser ? currUser.email : '' %>"
          class="form-control auth-input"
          placeholder="name@example.com"
          required
        />
        <div class="invalid-feedback">A valid email address is required.</div>
      </div>

      <button class="btn auth-btn w-100 mt-2" type="submit">
        Send Verification Link
      </button>
    </form>

    <p class="text-center mt-4 small mb-0">
      Remembered your account?
      <a href="/login" class="fw-semibold text-decoration-none">Log in</a>
    </p>
  </div>
</div>
