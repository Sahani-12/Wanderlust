<% layout("/layouts/boilerplate") %>

<div class="container d-flex flex-column justify-content-center align-items-center min-vh-75 text-center my-5">
  <div class="p-4 rounded-4 shadow-sm border bg-white" style="max-width: 580px; width: 100%;">
    <div class="mb-3">
      <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 3.5rem;"></i>
    </div>
    <h1 class="display-5 fw-bold text-dark mb-2">Error <%= err.statusCode || 500 %></h1>
    <h5 class="text-secondary mb-3"><%= err.message %></h5>

    <p class="text-muted mb-4 small">
      <% if (err.statusCode === 404) { %>
        The page you are looking for does not exist or has been moved.
      <% } else if (err.statusCode === 403) { %>
        You do not have permission to access this resource or your session token expired.
      <% } else { %>
        We ran into an unexpected issue while processing your request. Please try again.
      <% } %>
    </p>

    <div class="d-flex justify-content-center gap-2 mb-3">
      <a href="/listings" class="btn btn-dark px-4 py-2">
        <i class="fa-solid fa-house me-2"></i>Go to Listings
      </a>
    </div>

    <% if (err.stack) { %>
      <div class="text-start mt-4">
        <p class="fw-semibold text-danger small mb-1">Developer Stack Trace (Development Only):</p>
        <pre class="bg-light p-3 rounded small text-dark border overflow-auto" style="max-height: 220px; font-size: 11px;"><%= err.stack %></pre>
      </div>
    <% } %>
  </div>
</div>
