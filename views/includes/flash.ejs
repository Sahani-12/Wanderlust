<% const successMsg = (typeof success !== "undefined" && success) ? success : (typeof locals !== "undefined" && locals.success ? locals.success : null); %>
<% const errorMsg = (typeof error !== "undefined" && error) ? error : (typeof locals !== "undefined" && locals.error ? locals.error : null); %>

<% if (successMsg && successMsg.length) { %>
<div
  class="alert alert-success alert-dismissible fade show col-12 col-md-8 offset-md-2 my-3"
  role="alert"
>
  <%= successMsg %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>

<% if (errorMsg && errorMsg.length) { %>
<div
  class="alert alert-danger alert-dismissible fade show col-12 col-md-8 offset-md-2 my-3"
  role="alert"
>
  <%= errorMsg %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>
<% } %>
