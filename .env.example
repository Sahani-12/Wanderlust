
# -------------------------------------------------------------
# CareConnect Environment Variables
# Copy this file to .env and fill in your actual credentials.
# -------------------------------------------------------------

# Server Configuration
PORT=8080
NODE_ENV=development
APP_BASE_URL=http://localhost:8080

# Database
# For local development: mongodb://127.0.0.1:27017/wanderlust
# For production (Render/Atlas): mongodb+srv://<user>:<password>@cluster.mongodb.net/wanderlust
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust

# Session Secrets (Use long random strings in production)
SECRET=your_super_secret_session_key_here

# Cloudinary (Image Uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox (Geocoding & Interactive Maps)
MAP_TOKEN=your_mapbox_public_token

# Email Service (Nodemailer SMTP)
# e.g., for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="CareConnect <no-reply@careconnect.com>"

# Optional Google OAuth 2.0 (Leave empty if not using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
